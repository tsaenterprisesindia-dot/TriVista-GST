# TriVista GST - backend environment (CA laptop / local single-port install)
# Copy this file to .env in the backend folder, then fill in your values.

# Port for the app (single process serves API + frontend)
PORT=5000

# --- Database (local MariaDB/MySQL) ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
# Password you set for root when installing MariaDB (leave empty if no password)
DB_PASSWORD=
DB_NAME=triveni_gst_erp

# --- Security ---
# Strong random token. Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-this-to-a-long-random-string

# Comma-separated origins allowed for browser API access.
# When the frontend is served by this same server, the browser uses same-origin (no CORS needed).
# Only add this if you run the Vite dev server separately (http://localhost:5173).
CORS_ORIGIN=http://localhost:5000

# --- Live e-Invoice (IRP) ---
# Get these from your GST Suvidha Provider (GSP) / e-invoice API provider.
# Leave empty to use Sandbox mode (simulate IRN) during setup.
IRP_ENDPOINT=
IRP_AUTH=

# --- AI assistant (optional) ---
AI_API_KEY=
AI_MODEL=