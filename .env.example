# ============================================================
# Raiivay deployment — TriveniGST / TriVista GST ERP
# Copy to .env on Railway, or use the Variable editor to set
# each key. The backend reads these via process.env.* (no dotenv
# file is committed; Railway injects them directly).
# ============================================================

# ---- App / server -------------------------------------------------
PORT=5000
# Railway supplies PORT automatically; local override only.
CORS_ORIGIN=http://localhost:5173
# Set to your Railway domain in production, e.g. https://triveni-gst.up.railway.app

# ---- MySQL (managed Railway MySQL add-on, or DATABASE_URL) --------
DB_HOST=REPLACE_WITH_RAILWAY_MYSQL_HOST
DB_PORT=3306
DB_USER=root
DB_PASSWORD=REPLACE_WITH_MYSQL_PASSWORD
DB_NAME=triveni_gst
# If you prefer a single connection string, set DATABASE_URL instead:
# DATABASE_URL=mysql://USER:PASS@HOST:PORT/triveni_gst

# ---- Auth / JWT ---------------------------------------------------
JWT_SECRET=REPLACE_WITH_LONG_RANDOM_STRING
JWT_EXPIRES_IN=7d
# Used by secret.js to derive/verify tokens and encrypt stored keys.

# ---- Crypto (API-key & credential encryption in DB) ---------------
CRYPTO_SECRET=REPLACE_WITH_ANOTHER_LONG_RANDOM_STRING

# ---- Static frontend ----------------------------------------------
FRONTEND_DIST=frontend/dist
# Relative to backend/src. The server runs express.static here and
# falls back to index.html (SPA). Leave default.

# ---- e-Invoice / e-Way (GSTN sandbox for testing) -----------------
IRP_ENDPOINT=https://einvoice1.gst.gov.in/Others
IRP_AUTH=https://einvoice1.gst.gov.in
IRP_CANCEL_ENDPOINT=https://einvoice1.gst.gov.in/Others
EWB_ENDPOINT=https://ewaybillgst.gov.in
EWB_AUTH=REPLACE_WITH_EWAY_USERNAME

# ---- GST report payload version ------------------------------------
GSTR1_JSON_VERSION=v1.0

# ---- Seeder defaults (only used by db:init / db:seed) --------------
DEFAULT_COMPANY_NAME=Triveni Traders Pvt Ltd
DEFAULT_GSTIN=REPLACE_WITH_DEFAULT_GSTIN
DEFAULT_ADDRESS=REPLACE_WITH_DEFAULT_ADDRESS
GST_TAX_PREFERENCE=preserve

# ---- MYSQL fast import binary (optional, company backups) ----------
MYSQL_BIN=mysql
